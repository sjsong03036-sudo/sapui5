<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
  xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form"
  xmlns:table="sap.ui.table" xmlns:rowmodes="sap.ui.table.rowmodes"
  controllerName="local.sapui5.starter.controller.View3" displayBlock="true">
    <Page title="View3 - 엘리먼트 바인딩 연습" class="sapUiResponsiveContentPadding">
      <content>
        <VBox>
          <Title text="주문을 바꾸면 상세와 두 테이블이 함께 바뀝니다" level="H2" class="sapUiSmallMarginTop sapUiSmallMarginBottom" />
          <Label text="주문 선택" labelFor="orderSelect" />
          <Select id="orderSelect" selectedKey="0" change=".onOrderChange" class="sapUiSmallMarginBottom">
            <items>
              <core:Item key="0" text="ORD001 - 김민수" />
              <core:Item key="1" text="ORD002 - 이서연" />
            </items>
          </Select>

          <!-- 컨트롤러에서 이 VBox에 bindElement를 호출합니다.
               기준 객체: order 모델의 /orders/0 또는 /orders/1.
               엘리먼트 바인딩은 객체의 컨텍스트를 지정하는 것이며,
               필드의 프로퍼티 바인딩이나 배열의 집계 바인딩을 대체하지는 않습니다.
               아래에서는 컨텍스트를 상속받아 모든 경로를 상대 경로로 적습니다. -->
          <VBox id="orderDetail">
            <form:SimpleForm editable="false" layout="ResponsiveGridLayout"
              labelSpanL="3" labelSpanM="3" labelSpanS="12" adjustLabelSpan="false"
              emptySpanL="0" emptySpanM="0" columnsL="1" columnsM="1">
              <form:content>
                <core:Title text="선택한 주문 상세" />
                <!-- /가 없으므로 기준 객체 아래의 필드를 찾습니다.
                     order>customer → /orders/0/customer (첫 주문 선택 시) -->
                <Label text="주문 번호" /><Text text="{order>orderId}" />
                <Label text="고객명" /><Text text="{order>customer}" />
                <Label text="상태" /><Text text="{order>status}" />
                <Label text="배송지" /><Text text="{order>address}" />
              </form:content>
            </form:SimpleForm>

            <Title text="1. sap.ui.table.Table" level="H2" class="sapUiMediumMarginTop sapUiSmallMarginBottom" />
            <!-- 상대 집계 바인딩: order>items → /orders/0/items.
                 order>/items라고 쓰면 루트의 items를 찾으므로 이 데이터와 맞지 않습니다. -->
            <table:Table id="orderGridTable" rows="{order>items}" selectionMode="None" width="100%">
              <table:rowMode><rowmodes:Fixed rowCount="3" /></table:rowMode>
              <table:columns>
                <table:Column width="12rem">
                  <Label text="상품명" />
                  <table:template><Text text="{order>name}" /></table:template>
                </table:Column>
                <table:Column width="7rem" hAlign="End">
                  <Label text="수량" />
                  <table:template><Text text="{order>quantity}" /></table:template>
                </table:Column>
                <table:Column width="12rem" hAlign="End">
                  <Label text="단가" />
                  <table:template><ObjectNumber number="{path: 'order>price', type: 'sap.ui.model.type.Integer'}" unit="원" /></table:template>
                </table:Column>
              </table:columns>
            </table:Table>

            <Title text="2. sap.m.Table" level="H2" class="sapUiMediumMarginTop sapUiSmallMarginBottom" />
            <!-- 두 테이블 모두 같은 부모 컨텍스트 아래의 items 배열을 사용합니다.
                 행 안에서는 다시 행 컨텍스트가 적용됩니다.
                 첫 행의 order>name → /orders/0/items/0/name. -->
            <Table id="orderResponsiveTable" items="{order>items}" noDataText="주문 항목이 없습니다." class="sapUiMediumMarginBottom">
              <columns>
                <Column><Text text="상품명" /></Column>
                <Column hAlign="End"><Text text="수량" /></Column>
                <Column hAlign="End"><Text text="단가" /></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Text text="{order>name}" />
                    <Text text="{order>quantity}" />
                    <ObjectNumber number="{path: 'order>price', type: 'sap.ui.model.type.Integer'}" unit="원" />
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </VBox>
        </VBox>
      </content>
    </Page>
</mvc:View>
